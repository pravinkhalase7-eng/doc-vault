# Application
APP_ENV=development
APP_NAME=DocVault
APP_URL=http://localhost:3000
API_URL=http://localhost:8000
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=true

# Database
DATABASE_URL=postgresql+asyncpg://docvault:docvault@localhost:5432/docvault
DATABASE_SYNC_URL=postgresql://docvault:docvault@localhost:5432/docvault

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Auth
JWT_SECRET=change-me-jwt-secret-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Encryption (application-level, for future at-rest encryption)
ENCRYPTION_KEY=change-me-fernet-or-32-byte-key

# Gemini (server-side only — never expose to the frontend)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIMENSIONS=768

# SMTP (Hostinger)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_FROM=
EMAIL_FROM_NAME=DocVault

# Storage (Hostinger VPS disk — never expose via the web server)
STORAGE_ROOT=./storage/data
MAX_UPLOAD_SIZE=52428800
DEFAULT_STORAGE_QUOTA_BYTES=104857600

# OCR
OCR_ENGINE=tesseract
TESSERACT_CMD=tesseract

# Malware scan (optional ClamAV hook)
CLAMAV_ENABLED=false
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# Trash retention
TRASH_RETENTION_DAYS=30

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Demo guest login (prefilled on the sign-in screen)
GUEST_EMAIL=guest@example.com
GUEST_PASSWORD=guestpass1

# Rate limits
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_UPLOAD=30/minute
RATE_LIMIT_AI=20/minute

# Twilio voice calls for chat reminders (set in the Jenkins-uploaded doc-vault.env)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Web Push (optional — DocVault can also generate VAPID keys under STORAGE_ROOT)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_MAILTO=mailto:docvault@localhost

# Google sign-in (optional). Web OAuth client from Google Cloud Console.
# Redirect URI must match APP_URL + /api/v1/auth/google/callback
# Local APP_URL is typically http://localhost:3001 (this repo's frontend port).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Inbound email ingest.
# Shared inbox: people send from their DocVault login email to support@doxstation.com.
# Celery polls IMAP every minute. Map by From; subject picks the collection.
IMAP_HOST=imap.hostinger.com
IMAP_PORT=993
IMAP_USERNAME=support@doxstation.com
IMAP_PASSWORD=
IMAP_FOLDER=INBOX
# Optional private per-user addresses (Mailgun/Postmark webhook).
INBOUND_EMAIL_DOMAIN=in.docvault.doxstation.com
INBOUND_WEBHOOK_SECRET=

# Frontend (browser-safe)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=DocVault
