# DocVault deploy env template.
# Copy this file to a Jenkins Secret file (ID: doc-vault-env-file).
# Do not commit doc-vault.env — it is gitignored. Update Twilio and other
# secrets in the Jenkins-uploaded file, then rebuild the job.

# Application
APP_ENV=production
APP_NAME=DocVault
APP_URL=http://CHANGE_ME_HOST
API_URL=http://CHANGE_ME_HOST
SECRET_KEY=change-me-docvault-secret-key-32chars
DEBUG=false

# Postgres (used by docker compose)
POSTGRES_USER=docvault
POSTGRES_PASSWORD=change-me-strong-postgres-password
POSTGRES_DB=docvault

# Database (rewritten to postgres/redis hostnames by scripts/normalize_deploy_env.py)
DATABASE_URL=postgresql+asyncpg://docvault:change-me-strong-postgres-password@postgres:5432/docvault
DATABASE_SYNC_URL=postgresql://docvault:change-me-strong-postgres-password@postgres:5432/docvault

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Auth
JWT_SECRET=change-me-docvault-jwt-secret-32chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Encryption (application-level)
ENCRYPTION_KEY=change-me-docvault-encryption-key-32

# Gemini (server-side only — never expose to the frontend)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIMENSIONS=768

# SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_FROM=
EMAIL_FROM_NAME=DocVault

# Storage (Hostinger VPS disk — never expose via the web server)
STORAGE_ROOT=/var/lib/docvault
STORAGE_HOST_PATH=/var/lib/docvault
MAX_UPLOAD_SIZE=52428800
DEFAULT_STORAGE_QUOTA_BYTES=104857600

# OCR
OCR_ENGINE=tesseract
TESSERACT_CMD=tesseract

# Malware scan (optional ClamAV hook)
CLAMAV_ENABLED=false
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# Trash retention
TRASH_RETENTION_DAYS=30

# CORS (add your public UI origin)
CORS_ORIGINS=http://CHANGE_ME_HOST

# Demo guest login
GUEST_EMAIL=guest@example.com
GUEST_PASSWORD=guestpass1

# Rate limits
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_UPLOAD=30/minute
RATE_LIMIT_AI=20/minute

# Twilio voice calls for chat reminders.
# TWILIO_PHONE_NUMBER is the Twilio From number (E.164, e.g. +13853000641).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Web Push (optional — generated under STORAGE_ROOT if empty)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_MAILTO=mailto:docvault@localhost

# Host ports (Postgres/Redis/API stay on the Docker network; only Nginx is published).
# 80 is already used on the shared VPS, so DocVault listens on 8088.
WEB_HOST_PORT=8088

# Frontend (leave NEXT_PUBLIC_API_URL empty to use same-origin /api via Nginx)
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_APP_NAME=DocVault
